* text=auto
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sql text eol=lf
# R8 CD-1: without this, Windows default clones (core.autocrlf=true) check
# shell scripts out with CRLF and bash dies on the shebang line — the flagship
# one-click deploy script (README 方式 00) broke on first run for Windows users.
*.sh text eol=lf
*.svg text eol=lf
*.png binary
*.webp binary
*.sqlite binary